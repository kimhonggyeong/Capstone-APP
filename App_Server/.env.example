# Copy this file to .env and replace every YOUR_* value.
# Never commit the completed .env file.
# These database names match the current Full_Server deployment.
# start.bat/start.ps1 serves every service on port 8000; API_HOST/API_PORT are not used.

# Shared MongoDB Atlas connection
# Core and Scenario use MONGODB_URI with different database names.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Core stock/auth/trading server
MONGODB_DB=antitude_defense
JWT_SECRET=YOUR_RANDOM_JWT_SECRET
JWT_EXPIRE_DAYS=7
# Use real-environment KIS keys for the stock ranking endpoints.
KIS_APP_KEY=YOUR_KIS_APP_KEY
KIS_APP_SECRET=YOUR_KIS_APP_SECRET
KIS_MODE=real
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET

# Scenario server
DATA_BACKEND=mongodb
MONGODB_DATABASE=anttitude_scenario
MONGODB_CONNECT_TIMEOUT_MS=3000
DEFAULT_USER_ID=beta-user
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
KIS_ENV=real

# AI RAMEN judgment server
# Reuse the shared cluster; authentication reads the Core users database.
MONGO_URI=${MONGODB_URI}
RAMEN_MONGO_DB_NAME=anttitude_ai_judgment
AUTH_MONGO_URI=${MONGODB_URI}
AUTH_MONGO_DB_NAME=antitude_defense
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Dynamic watch: only symbols with an active authenticated /judgment/{symbol}/watch subscription.
# Send a heartbeat within WATCH_TTL_SEC; no subscriptions means no background KIS/LLM calls.
POLL_INTERVAL_SEC=10
WATCH_TTL_SEC=60
WATCH_REFRESH_GUARD_SEC=30
TRIGGER_COOLDOWN_SEC=300
PRICE_MOVE_THRESHOLD_PCT=0.5
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VOLUME_SURGE_RATIO=2
FUZZY_HOLD_BASELINE=0.3
SOFTMAX_TEMPERATURE=30
JUDGE_CHANGE_THRESHOLD_PCT=15
# AI RAMEN reads this URL directly; KIS_MODE/KIS_ENV do not select its endpoint.
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Market-reaction server
OLLAMA_HOST=http://127.0.0.1:11434
# Shared by AI RAMEN when LLM_PROVIDER=ollama and Market Reaction.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1
OLLAMA_TEMPERATURE=0.3
OLLAMA_EMBEDDING_MODEL=bge-m3
# Optional: used by DART collection/index-building utilities, not normal API requests.
DART_API_KEY=
# RAG uses these separate fields, even when MONGODB_URI is already configured.
# Use the same account as above; CLUSTER is the full hostname without mongodb+srv://.
STOTRA_MONGODB_USERNAME=YOUR_USERNAME
STOTRA_MONGODB_PASSWORD=YOUR_PASSWORD
STOTRA_MONGODB_CLUSTER=YOUR_CLUSTER.mongodb.net
MARKET_REACTION_MONGO_DB_NAME=antitude_defense
RAG_MAX_CACHED_STOCKS=20

# Optional legal chatbot: fill PINECONE_API_KEY only when using /legal-chatbot/ask.
# It shares OPENAI_API_KEY with AI RAMEN.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=law-crawlings-test
PINECONE_NAMESPACE=ns1
LEGAL_EMBEDDING_MODEL=text-embedding-3-small
LEGAL_CHAT_MODEL=gpt-4o-mini
