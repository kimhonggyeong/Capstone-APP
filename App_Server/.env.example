# Copy this file to .env and replace every YOUR_* value.
# Never commit the completed .env file.

# Shared MongoDB Atlas connection
# Core and Scenario use MONGODB_URI with different database names.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Core stock/auth/trading server
MONGODB_DB=stock_learning_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_DAYS=7
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MODE=paper
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Scenario server
DATA_BACKEND=mongodb
MONGODB_DATABASE=anttitude_scenario
MONGODB_CONNECT_TIMEOUT_MS=3000
DEFAULT_USER_ID=beta-user
GEMINI_API_KEY=
KIS_ENV=real

# AI RAMEN judgment server
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
RAMEN_MONGO_DB_NAME=entitude
AUTH_MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
AUTH_MONGO_DB_NAME=stock_learning_db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai
# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
NEWSAPI_API_KEY=
ENABLE_BACKGROUND_POLLING=false
WATCH_SYMBOLS=["011070"]
POLL_INTERVAL_SEC=10
NEWS_POLL_INTERVAL_SEC=1800
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# Market-reaction server
OLLAMA_HOST=http://127.0.0.1:11434
# Shared by AI RAMEN when LLM_PROVIDER=ollama and Market Reaction.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1
OLLAMA_TEMPERATURE=0.3
OLLAMA_EMBEDDING_MODEL=bge-m3
DART_API_KEY=
STOTRA_MONGODB_USERNAME=
STOTRA_MONGODB_PASSWORD=
STOTRA_MONGODB_CLUSTER=
MARKET_REACTION_MONGO_DB_NAME=
RAG_MAX_CACHED_STOCKS=

# Legal chatbot (the old hard-coded keys are intentionally not copied)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=law-crawlings-test
PINECONE_NAMESPACE=ns1
LEGAL_EMBEDDING_MODEL=text-embedding-3-small
LEGAL_CHAT_MODEL=gpt-4o-mini
